# ==========================================
# Kite SecOps Teammate Configuration
# ==========================================

# ── LLM Provider Keys ──
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_AI_API_KEY=your_google_gemini_api_key_here

# ── Models (Pinned to Verified Hackathon Specs) ──
RECON_MODEL=gemini-3.1-flash-lite
ATTACKER_MODEL=gpt-6-luna
FIX_ENGINE_MODEL=gpt-6-luna
VERIFIER_MODEL=gemini-3.1-flash-lite

# ── Discord & Switch Integration (MANDATORY) ──
DISCORD_BOT_TOKEN=your_discord_bot_token_here
SWITCH_SERVER_URL=http://switch-server:3000
SWITCH_TRUST_API_KEY=your_switch_trust_key_here
SWITCH_TRUST_GATEWAY_URL=

# ── Target Application & Infrastructure ──
TARGET_HOST=vynn.urbackend.in
HOST_REPO_PATH=/home/ubuntu/mcp-gateway-k8s

# ── GitHub GitOps Integration (For Real PRs & Issue Sync) ──
GITHUB_TOKEN=your_personal_access_token_here
GITHUB_REPO_OWNER=yash-pouranik
GITHUB_REPO_NAME=mcp-gateway-k8s

# ── Database & Redis Connections ──
POSTGRES_USER=secops
POSTGRES_PASSWORD=secops_secure_pass
POSTGRES_DB=cyberwar
DATABASE_URL=postgresql://secops:secops_secure_pass@postgres:5432/cyberwar
REDIS_URL=redis://redis:6379/0

# ── Application Runtime ──
ENVIRONMENT=development
LOG_LEVEL=INFO
