# ==========================================
# Kite SecOps Teammate Configuration
# ==========================================

# ── LLM Provider Keys ──
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_AI_API_KEY=your_google_gemini_api_key_here

# ── Models (Pinned to Verified Hackathon Specs) ──
RECON_MODEL=gemini-3.1-flash-lite
ATTACKER_MODEL=gpt-6-luna
FIX_ENGINE_MODEL=gpt-6-luna
VERIFIER_MODEL=gemini-3.1-flash-lite

# ── Discord & Switch Integration (MANDATORY) ──
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_APP_APPLICATION_ID=your_discord_application_id_here
DISCORD_APP_CLIENT_SECRET=your_discord_client_secret_here
SWITCH_SERVER_IMAGE=ghcr.io/sandbox-quantum/switch-core:latest
SWITCH_SERVER_URL=http://switch-server:8000
SWITCH_SECRET_KEYS=k1:secops_master_secret_key_32_chars_min_12345678
SWITCH_AGENT_REGISTRATION_TOKEN=secops-switch-token-2026
SWITCH_AGENT_ID=kite-secops
SWITCH_AGENT_API_KEY=
SWITCH_ROOM_ID=cyberwar-ops
SWITCH_ADMIN_EMAIL=admin@kite-secops.local
SWITCH_ADMIN_PASS=SecOpsAdminPass2026!
ENABLE_DIRECT_DISCORD_FALLBACK=false
SWITCH_TRUST_API_KEY=your_switch_trust_key_here
SWITCH_TRUST_GATEWAY_URL=

# ── Target Application & Infrastructure ──
TARGET_HOST=your_target_app_domain_or_ip
HOST_REPO_PATH=/path/to/target/repository
K8S_NAMESPACE=your_k8s_namespace_e_g_default_or_gateway

# ── GitHub GitOps Integration (For Real PRs & Issue Sync) ──
GITHUB_TOKEN=your_personal_access_token_here
GITHUB_REPO_OWNER=your_github_username_or_org
GITHUB_REPO_NAME=your_target_repo_name

# ── Database & Redis Connections ──
POSTGRES_USER=secops
POSTGRES_PASSWORD=secops_secure_pass
POSTGRES_DB=cyberwar
DATABASE_URL=postgresql://secops:secops_secure_pass@postgres:5432/cyberwar
REDIS_URL=redis://redis:6379/0

# ── Application Runtime ──
ENVIRONMENT=development
LOG_LEVEL=INFO
